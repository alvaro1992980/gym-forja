# Root .env is read by docker compose only. Copy to `.env` to override defaults.
# Backend variables live in backend/.env.example (created in D1).

# PostgreSQL container
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_DB=gym
# Second database for backend e2e tests (created on first start)
POSTGRES_TEST_DB=gym_test
# Host port mapped to the container's 5432 (5433 avoids clashing with a local Postgres)
POSTGRES_PORT=5433

# pgAdmin (only with `docker compose --profile tools up -d`)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
