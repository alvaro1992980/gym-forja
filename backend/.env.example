# Backend configuration. Copy to `.env` and adjust. Never commit `.env`.
# The app validates these at startup and exits with a clear error if one is missing or invalid.

# --- Runtime ---
# development | test | production
NODE_ENV=development
PORT=3000

# --- Database (docker compose in the repo root; host port 5433) ---
DATABASE_URL=postgresql://gym:gym@localhost:5433/gym?schema=public
# Separate database used by `npm run test:e2e` (reset per suite)
DATABASE_URL_TEST=postgresql://gym:gym@localhost:5433/gym_test?schema=public

# --- Auth (used from D2) ---
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days
JWT_REFRESH_TTL_DAYS=30

# --- Kiosk QR (used from D6) ---
QR_TOKEN_SECRET=change-me-qr-secret-at-least-32-chars
QR_TOKEN_TTL_SECONDS=45

# --- Gym ---
# IANA timezone for "today", days left and cron times
GYM_TIMEZONE=America/La_Paz

# --- Push notifications (used from D8) ---
# Firebase service account JSON, base64-encoded (see docs/FIREBASE_SETUP.md). Required only when PUSH_ENABLED=true.
FIREBASE_SERVICE_ACCOUNT_JSON=
# false = notifications are only stored and logged (no FCM calls)
PUSH_ENABLED=false

# --- HTTP ---
# Swagger UI at /api/docs. Off in production unless set to true.
SWAGGER_ENABLED=true
# Comma-separated allowed origins for CORS; empty = no browser origins allowed
# (mobile apps are not affected by CORS)
CORS_ORIGINS=http://localhost:3000
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Seed (prisma/seed.ts) ---
# First ADMIN account. Phone in normalized form: + country code + digits.
SEED_ADMIN_PHONE=+59170000000
# Minimum 8 characters. The admin must change it on first login.
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Gym
